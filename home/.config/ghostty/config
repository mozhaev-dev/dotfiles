# Font
# A Nerd Font: eza --icons and the tmux status bar draw glyphs from it.
font-family = "MesloLGL Nerd Font Mono"
font-size = 18

# Window
window-padding-x = 10
window-padding-y = 8

# Follow macOS light/dark appearance
window-theme = system

# Shell integration
shell-integration = detect

# ----MACHINE-LOCAL----

config-file = ?config.local
